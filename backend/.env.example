# WayFinder Backend Environment Variables

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/wayfinder"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV="development"

# Email (Resend)
# Sign up at https://resend.com to get your API key
RESEND_API_KEY="re_xxxxxxxxxxxxx"
EMAIL_FROM="WayFinder <onboarding@wayfinder.app>"
EMAIL_REPLY_TO="support@wayfinder.app"

# Google Maps API (for route calculation)
GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# CORS Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:4200"
